
# pixi environments
.pixi
*.egg-info

# Python
__pycache__/
*.py[cod]

# C/C++ Build
build/
main
*.o

# Data and Cache. The directories themselves are kept in the tree via
# .gitkeep so a fresh clone has somewhere to write; only their contents are
# ignored. A blanket `cache/` would exclude the directory outright and git
# would refuse to descend into it, so the .gitkeep could never be re-included.
cache/*
!cache/.gitkeep
*.dat

# Rendered output. gif_material once held 101 kep_double*.dat frames (~79 MB)
# and web_images the PNG/GIF renders; both are regenerated by the tools.
gif_material/*
!gif_material/.gitkeep
web_images/*
!web_images/.gitkeep
*.gif
